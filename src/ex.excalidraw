    {
      "id": "khMvglcePJEBHSvBNFz5H",
      "type": "text",
      "x": 61.111663818359375,
      "y": 629.2749511968522,
      "width": 815.1673583984375,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
