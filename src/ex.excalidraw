      "versionNonce": 1114496655,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784623367803,
      "link": null,
      "locked": false,
      "text": "the system must have one mutex shared betwen all threads",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the system must have one mutex shared betwen all threads",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pdZ_Q6c6ltByp9auyanJg",
      "type": "text",
      "x": 81.11166381835938,
      "y": 689.2749511968522,
      "width": 936.1558837890625,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 717592495,
      "version": 424,
      "versionNonce": 502354301,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784623729053,
      "link": null,
      "locked": false,
      "text": "Race condition happens when a thread do an action before a\n        mandatory action must be implemented by another thread \n\nData race happens when two or more threads need to use a shared\n    data, all of them raise to flag of lock, but none of them can lock\n    so they still waiting forever\n\nmutex solves the problem of data race but can cause a death lock",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Race condition happens when a thread do an action before a\n        mandatory action must be implemented by another thread \n\nData race happens when two or more threads need to use a shared\n    data, all of them raise to flag of lock, but none of them can lock\n    so they still waiting forever\n\nmutex solves the problem of data race but can cause a death lock",
      "autoResize": true,
      "lineHeight": 1.25
    },
